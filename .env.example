# ──────────────────────────────────────────────────────────
# Revenue Recovery Engine — Environment Configuration
# Copy to .env and fill in values before running docker-compose
# ──────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
APP_VERSION=0.1.0

# ── Database (PostgreSQL) ─────────────────────────────────
POSTGRES_USER=recovery
POSTGRES_PASSWORD=recovery_secret
POSTGRES_DB=revenue_recovery
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://recovery:recovery_secret@postgres:5432/revenue_recovery

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_STREAM_NAME=payment_events
REDIS_STREAM_CONSUMER_GROUP=rra_workers

# ── Temporal ──────────────────────────────────────────────
TEMPORAL_HOST=temporal
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=recovery-engine

# ── Razorpay ──────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── LLM (Phase 9 — stubbed for Phase 0) ──────────────────
LLM_PROVIDER=openai          # openai | anthropic | disabled
LLM_API_KEY=sk-placeholder
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=5

# ── Policy Gateway ────────────────────────────────────────
CLEARANCE_TOKEN_TTL_MINUTES=30
POLICY_SIGNING_SECRET=change-this-signing-secret

# ── pgAdmin ───────────────────────────────────────────────
PGADMIN_EMAIL=admin@recovery.local
PGADMIN_PASSWORD=admin

# ── Observability ─────────────────────────────────────────
ENABLE_METRICS=true
METRICS_PORT=9090
